# Python bytecode
__pycache__/
*.py[cod]

# Stage run outputs — logs + board snapshots, regeneratable and large
runs/
*.board-after.json

# Local env
.env
*.env

# Per-session capture directories (dump-results.sh, capture-board.sh output).
# Regeneratable from any CHAIN run — keep locally for analysis, don't commit.
captures/
# Per-session dumps under results/ are timestamp-named (e.g., 20261013T123248Z);
# we ignore anything starting with a digit. The reference sample-chain-run/
# (committed for documentation) is unaffected because its name starts with 's'.
results/[0-9]*
results/test-*
